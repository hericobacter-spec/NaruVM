+/* A separate control queue avoids waiting behind GPU-submission fences while pinning pages. */
+static int
+kbase_userptr_map(struct kbase_kmod_dev *kdev, uint64_t va, bool map)
+{
+   struct kbase_csf_dev *c = kdev->csfq;
+   if (!c) { errno = ENODEV; return -1; }
+   pthread_mutex_lock(&c->import_lock);
+   int ret = -1;
+   if (!c->import_queue_created) {
+      struct kbase_ioctl_kcpu_queue_new create = {0};
+      if (pan_kmod_ioctl(kdev->base.fd, KBASE_IOCTL_KCPU_QUEUE_CREATE, &create))
+         goto out;
+      c->import_queue_id = create.id;
+      c->import_queue_created = true;
+   }
+   struct base_fence fence = {.basep = {.fd = -1, .stream_fd = -1}};
+   struct base_kcpu_command cmds[2] = {
+      {.type = map ? 6 : 7, .info.pad = {va}},
+      {.type = BASE_KCPU_COMMAND_TYPE_FENCE_SIGNAL, .info.fence = {.fence = (uintptr_t)&fence}},
+   };
+   for (unsigned i = 0; i < 2; i++) {
+      struct kbase_ioctl_kcpu_queue_enqueue enq = {
+         .addr = (uintptr_t)&cmds[i], .nr_commands = 1, .id = c->import_queue_id};
+      if (pan_kmod_ioctl(kdev->base.fd, KBASE_IOCTL_KCPU_QUEUE_ENQUEUE, &enq))
+         goto out;
+   }
+   if (fence.basep.fd >= 0) {
+      struct pollfd wait = {.fd = fence.basep.fd, .events = POLLIN};
+      const int ready = poll(&wait, 1, 5000);
+      struct sync_file_info info = {0};
+      if (ready > 0 && !ioctl(fence.basep.fd, SYNC_IOC_FILE_INFO, &info) && info.status > 0)
+         ret = 0;
+      else if (ready == 0)
+         errno = ETIMEDOUT;
+      else if (ready > 0)
+         errno = EIO;
+      close(fence.basep.fd);
+   } else {
+      errno = EIO;
+   }
+out:
+   pthread_mutex_unlock(&c->import_lock);
+   return ret;
+}
