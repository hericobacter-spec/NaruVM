#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Source { uint source[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Destination { uint destination[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < 16384) destination[i] = source[i] * 3u + 7u;
}
