+fn ordered_primitive_fallback_requires_a_consumer_contract() {
+    let Some(bc) = fixture("fragment_rog") else {
+        return;
+    };
+    let p = moltenvk_without(&[
+        VkFeature::FragmentShaderPixelInterlock,
+        VkFeature::FragmentShaderSampleInterlock,
+    ]);
+    let mut inputs = LoweringInputs::new();
+    assert!(matches!(
+        compile_with(&bc, "rog_buffer", &p, &inputs),
+        Err(Error::Unsupported(_))
+    ));
+    inputs.ordered_fragment_primitives = true;
+    let a = compile_with(&bc, "rog_buffer", &p, &inputs).expect("ordered consumer");
+    assert!(a.facts.contains(&RuntimeFact::OrderedFragmentPrimitives));
+    link_and_validate(&a, &p).expect("valid ordinary storage accesses");
+    let (_, module) = typed_module_with(&bc, "rog_buffer", &p, &inputs).expect("typed");
+    assert!(!module.entry().modes.iter().any(|m| matches!(
+        m,
+        ExecMode::PixelInterlockOrdered | ExecMode::SampleInterlockOrdered
+    )));
+    inputs.multisampled = true;
+    assert!(matches!(
+        compile_with(&bc, "rog_buffer", &p, &inputs),
+        Err(Error::Unsupported(_))
+    ));
+    inputs.multisampled = false;
+    assert!(matches!(
+        compile_with(&bc, "rog_sample", &p, &inputs),
+        Err(Error::Unsupported(_))
+    ));
+}
