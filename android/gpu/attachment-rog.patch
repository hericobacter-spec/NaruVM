+
+/// A bounded cache releases only its oldest idle spare of the returning pool's family.
+#[test]
+fn bounded_command_pools_keep_newest_per_family() {
+    let mut pools = Vec::new();
+    for (raw, family) in [(1, 0), (2, 1), (3, 0), (4, 1)] {
+        keep_command_pool(
+            &mut pools,
+            CommandPool::new(vk::CommandPool::from_raw(raw), family),
+        );
+        assert!(excess_command_pool(&mut pools, family, Some(2)).is_none());
+    }
+    keep_command_pool(
+        &mut pools,
+        CommandPool::new(vk::CommandPool::from_raw(5), 0),
+    );
+    assert!(excess_command_pool(&mut pools, 0, None).is_none());
+    assert_eq!(
+        excess_command_pool(&mut pools, 0, Some(2))
+            .expect("oldest excess")
+            .raw,
+        vk::CommandPool::from_raw(1)
+    );
+    assert!(excess_command_pool(&mut pools, 1, Some(2)).is_none());
+    assert_eq!(
+        take_command_pool(&mut pools, 0).expect("newest").raw,
+        vk::CommandPool::from_raw(5)
+    );
+    assert_eq!(
+        take_command_pool(&mut pools, 0).expect("second").raw,
+        vk::CommandPool::from_raw(3)
+    );
+    assert!(take_command_pool(&mut pools, 0).is_none());
+    assert_eq!(pools.len(), 2);
+}
