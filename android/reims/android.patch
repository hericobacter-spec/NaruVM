@@ -0,0 +1,49 @@
+//! Android has no library-owned desktop window. The embedding app presents display frames
+//! through the display API. A request for a library window is explicitly refused and closed.
+
+use crate::handle::Window;
+use crate::screens::HostScreen;
+use crate::{Presenter, VulkanTarget};
+use reims_vgpu_core::platform::os::MonoTime;
+use std::sync::{Arc, OnceLock};
+use std::time::Instant;
+
+/// What a host window would ask of a Vulkan display sink. Android's app owns presentation.
+pub trait FrameSink: Send + Sync {
+    /// A presenter if the embedding host supplies a native window target.
+    fn presenter(&self, target: &dyn VulkanTarget) -> Option<Box<dyn Presenter>>;
+    /// The display cursor, absent where the sink cannot read it.
+    fn guest_cursor_position(&self) -> Option<(u16, u16)> {
+        None
+    }
+}
+
+/// No native window or render thread exists on Android.
+#[derive(Debug, Default)]
+pub(crate) struct Surface;
+impl Surface {
+    pub(crate) fn new() -> Self {
+        Self
+    }
+    pub(crate) fn request_draw(&self) {}
+    pub(crate) fn close(&self) {}
+}
+
+pub(crate) fn open(window: &Arc<Window>) {
+    log::warn!(
+        "Android has no library-owned window; use display frame callbacks in the embedding app"
+    );
+    window.close();
+}
+pub(crate) fn close(_id: u64) {}
+pub(crate) fn cursor_changed(_id: u64) {}
+pub(crate) fn guest_mode_changed(_id: u64) {}
+pub(crate) fn host_screens() -> Vec<HostScreen> {
+    Vec::new()
+}
+pub(crate) fn now() -> MonoTime {
+    static START: OnceLock<Instant> = OnceLock::new();
+    MonoTime::from_nanos(
+        u64::try_from(START.get_or_init(Instant::now).elapsed().as_nanos()).unwrap_or(u64::MAX),
+    )
+}
