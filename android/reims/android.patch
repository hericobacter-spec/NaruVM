diff --git a/crates/reims-vgpu-vulkan/src/api/frame_readback.rs b/crates/reims-vgpu-vulkan/src/api/frame_readback.rs
new file mode 100644
index 0000000..75c5f9f
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/api/frame_readback.rs
@@ -0,0 +1,70 @@
+//! Library-owned frame targets read through a reused shared buffer. The copy is part of the
+//! frame's command buffer, not a new submission that could wait behind guest event work.
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::num::ToUsize as _;
+
+use crate::answer::{get, plain};
+use crate::gpu::command::VulkanCommandBuffer;
+use crate::gpu::resource::VulkanTexture;
+
+/// A frame target's shared readback buffer, retained by every command that copies into it.
+/// This is only for the embedding host's frame targets, never a guest texture's `getBytes`.
+pub struct FrameReadback {
+    buffer: rt::Buffer,
+    width: u64,
+    height: u64,
+}
+
+impl FrameReadback {
+    /// Allocate once for a frame target's checked dimensions. A new shared buffer reads zero.
+    pub fn new(texture: &VulkanTexture) -> Self {
+        let width = plain(|| texture.raw.width());
+        let height = plain(|| texture.raw.height());
+        let length = width * height * 4;
+        let buffer = get("newBufferWithLength:options:", || {
+            texture
+                .device
+                .raw
+                .new_buffer(length, rt::ResourceOptions::shared())
+        });
+        eprintln!("REIMS_FRAME_READBACK method=same_batch_buffer bytes={length}");
+        Self {
+            buffer,
+            width,
+            height,
+        }
+    }
+
+    /// Append a whole-image copy after the frame draw. Completion of this same command buffer
+    /// covers the GPU writes and host visibility; no queue is waited on while encoding.
+    pub fn encode(&self, command: &VulkanCommandBuffer, texture: &VulkanTexture) {
+        let mut blit = get("blitCommandEncoder", || command.raw.blit_command_encoder());
+        get("copyFromTexture:toBuffer:", || {
+            blit.copy_from_texture_to_buffer(
+                &texture.raw,
+                0,
+                0,
+                rt::Origin::new(0, 0, 0),
+                rt::Size::new(self.width, self.height, 1),
+                &self.buffer,
+                0,
+                self.width * 4,
+                self.width * self.height * 4,
+                rt::BlitOption::None,
+            )
+        });
+        get("endEncoding", || blit.end_encoding());
+    }
+
+    /// Copy after the host waited for the frame. Its caller checked the row stride and extent.
+    pub fn read_pixels(&self, dst: &mut [u8], bytes_per_row: usize) {
+        let pointer =
+            plain(|| self.buffer.contents()).expect("shared frame buffer is host visible");
+        let row = (self.width * 4).to_usize();
+        for y in 0..self.height.to_usize() {
+            // SAFETY: shared coherent buffer, frame complete, extent checked by FrameTarget.
+            let source = unsafe { std::slice::from_raw_parts(pointer.as_ptr().add(y * row), row) };
+            dst[y * bytes_per_row..y * bytes_per_row + row].copy_from_slice(source);
+        }
+    }
+}
